    active: true,
    createdAt: new Date("2024-01-01"),
    requirements: {
      verificationMethod: "staking",
      minimumAmount: 100,
      minimumDuration: 604800, // 7 days in seconds
    },
  },
  {
    id: 2,
    name: "Provide Liquidity",
    description: "Provide liquidity to any supported trading pair",
    rewardAmount: 750,
    rewardTiers: ["Bronze", "Silver", "Gold"],
    maxCompletions: 500,
    completions: 218,
    active: true,
    createdAt: new Date("2024-01-05"),
    requirements: {
      verificationMethod: "liquidity",
      minimumAmount: 1000,
      minimumDuration: 86400, // 1 day
    },
  },
  {
    id: 3,
    name: "Execute Multi-Step Swap",
    description: "Execute a complex swap route involving 3+ assets",
    rewardAmount: 300,
    rewardTiers: ["Bronze", "Silver"],
