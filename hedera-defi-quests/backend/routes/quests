    },
  },
];

/**
 * GET /api/quests - List all available quests
 */
router.get("/", (req, res) => {
  try {
    const { active } = req.query;

    let filteredQuests = quests;
    if (active === "true") {
      filteredQuests = quests.filter((q) => q.active);
    }

    res.json({
      success: true,
      data: filteredQuests,
      count: filteredQuests.length,
    });
  } catch (error) {
    res.status(500).json({
      success: false,
      error: error.message,
    });
  }
});

/**
 * GET /api/quests/:id - Get specific quest details
 */
router.get("/:id", (req, res) => {
  try {
    const { id } = req.params;
    const quest = quests.find((q) => q.id === parseInt(id));

    if (!quest) {
      return res.status(404).json({
        success: false,
        error: "Quest not found",
      });
    }

    res.json({
      success: true,
      data: quest,
    });
  } catch (error) {
    res.status(500).json({
      success: false,
      error: error.message,
    });
  }
});

/**
 * GET /api/quests/category/:category - Get quests by category
 */
router.get("/category/:category", (req, res) => {
  try {
    const { category } = req.params;
    const filteredQuests = quests.filter(
      (q) =>
        q.requirements.verificationMethod.toLowerCase() ===
        category.toLowerCase()
    );

    if (filteredQuests.length === 0) {
      return res.status(404).json({
        success: false,
        error: "No quests found in this category",
      });
    }

    res.json({
      success: true,
      data: filteredQuests,
      count: filteredQuests.length,
    });
  } catch (error) {
    res.status(500).json({
      success: false,
      error: error.message,
    });
  }
});

module.exports = router;
